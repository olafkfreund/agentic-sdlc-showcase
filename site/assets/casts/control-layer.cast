[5.555043, "m", "The configuration regression suite"]
[5.555043, "o", "\r\n\u001b[38;5;208m\u001b[1m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[38;5;208m\u001b[1m  Act 6 · The configuration regression suite\u001b[0m\r\n"]
[5.55514, "o", "\u001b[38;5;208m\u001b[1m──────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[2mA change to AGENTS.md, a skill, a gate or a model route is a change to the\u001b[0m\r\n"]
[5.555263, "o", "  \u001b[2magent's behaviour, and gets regression-tested like the code it produces.\u001b[0m\r\n\r\n  \u001b[1m$ make eval PY=python\u001b[0m\r\n\r\n"]
[5.557181, "o", "python .agent/evals/run.py\r\n"]
